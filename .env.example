# 公開サイト（メインアプリ）の環境変数
# 実際の値は .env.local にコピーして設定する（.env* は .gitignore 済み）

# PostgreSQL接続文字列（admin側の DATABASE_URL と同じDBを指す）
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# お問い合わせフォーム送信メール（Resend: https://resend.com）
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# 送信元・送信先メールアドレス（未設定時はコード内のデフォルト値を使用）
FROM_EMAIL="noreply@kukka.info"
ADMIN_EMAIL="takahashi_s@kukka.info"
