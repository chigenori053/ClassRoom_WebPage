# 管理画面（adminアプリ）の環境変数
# 実際の値は .env.local にコピーして設定する（.env* は .gitignore 済み）

# PostgreSQL接続文字列（メインアプリの DATABASE_URL と同じDBを指す）
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 管理画面ログインパスワード
ADMIN_PASSWORD="change-me"

# Google Apps Script 経由のGoogleカレンダー連携先エンドポイントと共有シークレット
GAS_ENDPOINT="https://script.google.com/macros/s/xxxxxxxx/exec"
GAS_SECRET="xxxxxxxxxxxxxxxx"
